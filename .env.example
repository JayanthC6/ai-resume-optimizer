# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ai_resume_db

# Full connection string used by Prisma (auto-built inside Docker from above vars)
# Override this only if connecting to an external Postgres instance:
# DATABASE_URL=postgresql://postgres:password@localhost:15432/ai_resume_db?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
# Overrides the internal redis://redis:6379 — use this for an external Redis (e.g. Upstash)
# REDIS_URL=redis://...

# ─── API & Security ───────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=development_secret_key_change_in_production
AUTH_EXPIRATION=7d

# ─── AI ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=models/gemini-flash-latest
GOOGLE_GEMINI_FALLBACK_MODELS=models/gemini-2.0-flash,models/gemini-2.5-flash

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL the browser uses to call the API. Keep as localhost for local dev.
VITE_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
