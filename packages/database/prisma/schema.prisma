// This is your Prisma schema file.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  hashedPassword  String
  resetPasswordTokenHash      String?
  resetPasswordTokenExpiresAt DateTime?
  fullName        String?
  subscription    String   @default("free")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resumes         Resume[]
  interviewSessions InterviewSession[]
  jobTargets      JobTarget[]
  reverseQuestions ReverseQuestionSet[]
  drafts          Draft[]
  planTasks       PlanTask[]
  planReminderSetting PlanReminderSetting?
}

model Resume {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  originalFilename String
  s3Key            String     @unique
  rawText          String?    @db.Text
  parsedData       Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  analyses         Analysis[]
  jobTargets       JobTarget[]
}

model Analysis {
  id              String   @id @default(uuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id])
  jobTitle        String
  companyName     String?
  jobDescription  String   @db.Text
  status          String   @default("pending") // pending, processing, completed, failed
  matchScore      Float?
  atsScore        Float?
  gapAnalysis     Json?
  keywordAnalysis Json?
  rewrites        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reverseQuestions ReverseQuestionSet[]
  drafts          Draft[]
  planTasks       PlanTask[]
}

model InterviewSession {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  resumeId         String
  jobTitle         String
  jobDescription   String             @db.Text
  mode             String             // Behavioral, Technical, Mixed
  language         String?            // Preferred coding language
  status           String             @default("active") // active, completed, failed
  overallScore     Int?
  technicalScore   Int?
  communicationScore Int?
  report           Json?              // { strengths, improvements }
  messages         InterviewMessage[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model InterviewMessage {
  id               String           @id @default(uuid())
  sessionId        String
  session          InterviewSession @relation(fields: [sessionId], references: [id])
  role             String           // user, assistant, system
  content          String           @db.Text
  createdAt        DateTime         @default(now())
}

model JobTarget {
  id              String   @id @default(uuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobTargets      Json     // Array of job targets { title, company, jd, fitRanking }
  missingKeywords Json?    // Array of missing keywords
  priorityList    Json?    // Array of "learn these first" items
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([resumeId])
  @@index([userId])
}

model ReverseQuestionSet {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  questions  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
}

model Draft {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  type       String   // cover_letter, recruiter_message, follow_up_email
  tone       String
  length     String
  title      String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
}

model PlanTask {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId  String
  analysis    Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  phase       String   // day30, day60, day90
  title       String
  description String?
  status      String   // todo, in_progress, done
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([analysisId])
  @@unique([analysisId, phase, title])
}

model PlanReminderSetting {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  frequency String   @default("weekly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
